.cloud {
    flex: 1 1 auto
    max-height: none
    min-height: 0
    overflow: auto
    padding: 8px 10px 14px
}

.label {
    margin: 0 2px 8px
    font-size: var(--secondary-font-size, 12px)
    color: var(--secondary-text-color, #999)
}

.pills {
    display: flex
    flex-wrap: wrap
    align-content: flex-start
    gap: 6px
}

.pill, .active {
    display: inline-flex
    align-items: center
    gap: 6px
    width: auto
    max-width: 100%
    border: 0
    border-radius: 999px
    padding: 4px 8px 4px 10px
    background: var(--secondary-background-color, rgba(255,255,255,.08))
    color: inherit
    font: inherit
    line-height: 1.3
    cursor: pointer
    white-space: nowrap
}

.active {
    background: var(--accent-color, #e8a317)
    color: var(--accent-text-color, #1c1915)
}

.count {
    font-variant-numeric: tabular-nums
    opacity: .8
}
